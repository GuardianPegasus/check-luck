# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ---
POSTGRES_DB=luck
POSTGRES_USER=luck
POSTGRES_PASSWORD=luck
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Период акции (важно: даты НЕ зашиты в коде) ---
PROMO_START_DATE=2026-01-01
PROMO_END_DATE=2026-12-31
# Часовой пояс, в котором считаются границы периода акции
PROMO_TIMEZONE=Europe/Moscow

# --- Правила акции ---
MIN_RECEIPT_AMOUNT=1000
MAX_RECEIPTS_PER_USER=0

# --- Загрузка фото чека (необязательная функция) ---
RECEIPT_PHOTO_MAX_MB=5
RECEIPT_PHOTO_ALLOWED_TYPES=jpg,jpeg,png,webp

# --- База (для запуска без Docker) ---
# По умолчанию PostgreSQL. Чтобы тесты и локальный запуск работали
# без внешнего сервиса, поставьте sqlite.
DB_ENGINE=postgresql

# --- Безопасность на боевом сервере ---
# Применяются только при DJANGO_DEBUG=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# 0 — не включать HSTS. Разумное значение для боевого домена: 31536000
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Поставьте True, если приложение стоит за прокси, который пересылает
# X-Forwarded-Proto (nginx, Traefik, Heroku-подобные платформы)
DJANGO_BEHIND_HTTPS_PROXY=False